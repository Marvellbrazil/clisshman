#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const packages = {
  "win32-x64": "clisshman-win32-x64",
  "linux-x64": "clisshman-linux-x64-musl",
  "darwin-x64": "clisshman-darwin-x64",
  "darwin-arm64": "clisshman-darwin-arm64",
};

const platformKey = `${process.platform}-${process.arch}`;
const binaryName = process.platform === "win32" ? "clisshman.exe" : "clisshman";
const launcherPath = fs.realpathSync(__filename);

function fail(message) {
  process.stderr.write(`clisshman: ${message}\n`);
  process.exit(1);
}

function usable(candidate) {
  try {
    const resolved = fs.realpathSync(candidate);
    if (resolved === launcherPath || !fs.statSync(resolved).isFile()) {
      return null;
    }
    return resolved;
  } catch {
    return null;
  }
}

function locateBinary() {
  const candidates = [];
  const packageName = packages[platformKey];
  if (packageName) {
    try {
      candidates.push(require.resolve(`${packageName}/bin/${binaryName}`));
    } catch {}
  }
  const root = path.join(__dirname, "..");
  candidates.push(path.join(root, "npm", platformKey, "bin", binaryName));
  candidates.push(path.join(root, "target", "release", binaryName));
  for (const candidate of candidates) {
    const binary = usable(candidate);
    if (binary) {
      return binary;
    }
  }
  return null;
}

const binary = locateBinary();
if (!binary) {
  if (!packages[platformKey]) {
    fail(
      `no prebuilt binary is available for ${platformKey}. Build from source with "cargo install --path ."`,
    );
  }
  fail(
    `the ${packages[platformKey]} package binary was not found. Reinstall with optional dependencies enabled, or build from source with "cargo install --path ."`,
  );
}

const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });

if (result.error) {
  fail(`cannot start ${binary}: ${result.error.message}`);
}

if (result.signal) {
  process.kill(process.pid, result.signal);
  process.exit(128 + (os.constants.signals[result.signal] || 0));
}

process.exit(result.status === null ? 1 : result.status);
