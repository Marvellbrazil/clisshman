#!/usr/bin/env node
const { spawnSync } = require("child_process");
const path = require("path");
const fs = require("fs");

const platform = process.platform;
const arch = process.arch;

let binaryName = "clisshman";
if (platform === "win32") {
  binaryName += ".exe";
}

let pkgName = "";
if (platform === "win32" && arch === "x64") {
  pkgName = "clisshman-win32-x64";
} else if (platform === "linux" && arch === "x64") {
  pkgName = "clisshman-linux-x64-musl";
} else if (platform === "darwin" && arch === "x64") {
  pkgName = "clisshman-darwin-x64";
} else if (platform === "darwin" && arch === "arm64") {
  pkgName = "clisshman-darwin-arm64";
}

let binPath = "";
try {
  binPath = require.resolve(`${pkgName}/bin/${binaryName}`);
} catch (e) {
  binPath = path.join(__dirname, binaryName);
}

const result = spawnSync(binPath, process.argv.slice(2), { stdio: "inherit" });
process.exit(result.status || 0);
